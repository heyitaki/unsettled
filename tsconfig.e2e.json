{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "types": ["node"],

    /* Bundler mode, matching the app project: the specs import app modules
       (constants the assertions must stay tied to) and resolve them the way
       Vite and Playwright's own loader do. */
    "module": "esnext",
    "moduleResolution": "bundler",

    /* Linting */
    "strict": true
  },
  "include": ["e2e", "playwright.config.ts", "playwright.production.config.ts"]
}
