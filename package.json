{
  "name": "unsettled",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --exclude src/engine/__tests__/perf.test.ts --exclude src/engine/advice/__tests__/advicePerf.test.ts --exclude src/engine/__tests__/analysisPerf.test.ts && vitest run src/engine/__tests__/perf.test.ts && vitest run src/engine/advice/__tests__/advicePerf.test.ts && vitest run src/engine/__tests__/analysisPerf.test.ts",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.production.config.ts",
    "typecheck": "tsc -b",
    "ios:build": "tsc -b && vite build --mode native && cap sync ios",
    "ios:archive": "npm run ios:build && ios/archive.sh",
    "ios:upload": "xcodebuild -exportArchive -archivePath ios/App/build/Unsettled.xcarchive -exportOptionsPlist ios/ExportOptions.plist -exportPath ios/App/build/export -allowProvisioningUpdates"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-share-target": "^8.0.65",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
